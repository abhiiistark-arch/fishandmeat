# Fish and Meat — environment
# Copy to .env and fill in values. Never commit your real .env file.

# Admin portal — staff logins are created by Super Admin in the Staff module.
# Bootstrap Super Admin (auto-seeded): username abhi / password abhi123
# Locked recovery Super Admin is hardcoded in app.py (fam-master) and re-synced
# into Mongo on every boot — use that if you forget a Staff password.
# ADMIN_PASSWORD remains a recovery fallback for username "abhi" or "admin".
ADMIN_PASSWORD=change-me

# Flask session secret — change in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Production hardening
# FAM_ENV=production
# FLASK_DEBUG=0
# SESSION_COOKIE_SECURE=true
# Behind nginx (TLS terminated on nginx → gunicorn):
# FAM_BEHIND_PROXY=1
# Optional allow-list for mobile APK origins (comma-separated)
# FAM_MOBILE_ORIGINS=https://your-domain.com,capacitor://localhost

# Run modes:
#   Dev:  python app.py
#   Prod: gunicorn -c gunicorn.conf.py "app:app"
#         (bind default 127.0.0.1:8000 — point nginx proxy_pass here)
# GUNICORN_WORKERS=4
# GUNICORN_BIND=127.0.0.1:8000

# --- MongoDB (REQUIRED) ---
# App is Mongo-only — no local JSON fallback. Without a URI it will not start.
# Set ONLY ONE of these; app uses the first non-empty value it finds:
#
#   MONGO_URI          — generic (Atlas or local)
#   MONGODB_URI        — alternate name
#   MONGO_ATLAS_URI    — MongoDB Atlas (mongodb+srv://…)
#   MONGODB_ATLAS_URI  — alternate Atlas name
#   MONGO_LOCAL_URI    — normal/local Mongo (mongodb://127.0.0.1:27017)
#
# Atlas example:
# MONGO_ATLAS_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# IMPORTANT: URL-encode special characters in the password, e.g. ! @ # -> %21 %40 %23
#
# Local / self-hosted example:
# MONGO_LOCAL_URI=mongodb://127.0.0.1:27017
# MONGO_LOCAL_URI=mongodb://fam_user:STRONG_PASSWORD@127.0.0.1:27017/fishandmeat?authSource=admin
#
MONGO_URI=
# MONGO_ATLAS_URI=
# MONGO_LOCAL_URI=

# Database name (first non-empty of MONGO_DB_NAME / MONGODB_DB_NAME / MONGO_DATABASE)
MONGO_DB_NAME=fishandmeat

# Prefer a dedicated mongo.env on the server (gitignored) so DB secrets stay out of .env:
#   1. Copy mongo.env.example → mongo.env  (or .mongo.env)
#   2. Put Atlas OR local URI there (only one needed)
# App loads .env then mongo.env from the server filesystem only (not via HTTP).

# On Vercel also set:
# SESSION_COOKIE_SECURE=true
# (cookies are forced secure automatically when VERCEL=1)
