# MongoDB connection file (REQUIRED).
# Copy to mongo.env (or .mongo.env) next to app.py — NEVER commit the real file.
# App loads: .env first, then mongo.env / .mongo.env (overrides).
#
# Set ONLY ONE URI — app uses the first non-empty of:
#   MONGO_URI | MONGODB_URI | MONGO_ATLAS_URI | MONGODB_ATLAS_URI | MONGO_LOCAL_URI
# Without a working URI the app will not start (Mongo-only; no local JSON).

# --- Option A: normal / local MongoDB on the same server ---
MONGO_LOCAL_URI=mongodb://127.0.0.1:27017
# With auth (recommended for production):
# MONGO_LOCAL_URI=mongodb://fam_user:STRONG_PASSWORD@127.0.0.1:27017/fishandmeat?authSource=admin

# --- Option B: MongoDB Atlas (cloud) — uncomment and clear Option A ---
# MONGO_ATLAS_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Or use the generic name for either:
# MONGO_URI=mongodb://127.0.0.1:27017
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGO_DB_NAME=fishandmeat
