# Optional MongoDB connection file (recommended on your server).
# Copy to mongo.env (or .mongo.env) next to app.py — NEVER commit the real file.
# App loads: .env first, then mongo.env / .mongo.env (overrides).

# Local MongoDB on the same server (example):
MONGO_URI=mongodb://127.0.0.1:27017

# Or with auth (recommended for production):
# MONGO_URI=mongodb://fam_user:STRONG_PASSWORD@127.0.0.1:27017/fishandmeat?authSource=admin

# Atlas (only if you still use cloud):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGO_DB_NAME=fishandmeat
